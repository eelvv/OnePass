# Reference projects (upstream open-source sources, only for functional reference)
/reference/

# Rust build artifacts (workspace + legacy engine-local)
/target/
/engine/target/
/engine/.cargo-home/
# Machine-specific cargo mirror workaround (see engine/README.md)
/.cargo/config.toml

# Vestigial member lock: the workspace-root Cargo.lock governs all members,
# so this file is never read by cargo and only drifts out of date.
/engine/Cargo.lock

# Generated by the example programs (default output paths of create_demo,
# save_demo and import_otp). Regenerate with:
#   cargo run --release --example create_demo
/examples/output.kdbx
/examples/imported.kdbx

# Real vaults must never be committed. onepass-cli defaults to this filename
# when invoked with no argument, so guard it explicitly.
/passwords.kdbx
*.kdbx.lock

# OS / editor
.DS_Store
.idea/
*.iml

.cargo-local/
