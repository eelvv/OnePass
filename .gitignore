# Reference projects (upstream open-source sources, only for functional reference)
/reference/

# Rust build artifacts
/target/
/engine/target/
/engine/.cargo-home/
# Machine-local cargo configuration (never uploaded)
/.cargo/config.toml

# Machine-local workspace: caches, vendored tooling, scratch files.
# Everything personal stays under this single generic directory.
/.local/

# Member crates have no lock of their own: the workspace-root Cargo.lock
# governs all members and any member-level file only drifts out of date.
/engine/Cargo.lock
/app/rust/Cargo.lock

# Generated by the example programs. Regenerate with:
#   cargo run --release --example create_demo
/examples/output.kdbx
/examples/imported.kdbx

# Real vaults must never be committed (onepass-cli default name covered too)
/passwords.kdbx
*.kdbx.lock

# OS / editor
.DS_Store
.idea/
*.iml
